generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model WaitTimeRecord {
  id         String   @id @default(uuid())
  rideId     Int
  rideName   String
  landName   String
  parkId     Int      @default(16)
  waitTime   Int
  isOpen     Boolean
  windowedAt DateTime
  recordedAt DateTime @default(now())

  @@unique([rideId, windowedAt])
  @@index([rideId, recordedAt])
  @@index([recordedAt])
  @@index([parkId, windowedAt])
}

model DailyForecast {
  id            String   @id @default(uuid())
  rideId        Int
  rideName      String
  landName      String
  parkId        Int      @default(16)
  forecastFor   DateTime
  predictedWait Int
  crowdScore    Int
  mlConfidence  Float
  createdAt     DateTime @default(now())

  @@unique([rideId, forecastFor])
  @@index([forecastFor])
  @@index([parkId, forecastFor])
}

// Stores per-date signals used to improve crowd score accuracy:
// Disney ticket tier, holiday/school-break flags, weather forecast, and Groq adjustment.
model DateContext {
  id              String    @id @default(uuid())
  date            DateTime // midnight UTC for the local park date
  parkId          Int       @default(16)
  tier            Int?      // Disney ticket tier 0–5 (higher = pricier/busier)
  isHoliday       Boolean   @default(false)
  isSchoolBreak   Boolean   @default(false)
  specialEvent    String?
  tierFetchedAt   DateTime? // when tier was last fetched; re-fetch after 24h
  tierSource      String?   // e.g. "disney-ticketing"
  groqDowEstimate Json?     // cached Map<dow, score> from estimateDowCrowdScores
  // Weather fields (Open-Meteo; climatological fallback beyond 16-day forecast window)
  tempHigh        Float?    // forecast high temperature in Fahrenheit
  tempLow         Float?    // forecast low temperature in Fahrenheit
  precipMm        Float?    // total precipitation in mm
  isRainy         Boolean?  // true when precipMm >= 2.5
  weatherFetchedAt DateTime? // when weather was last fetched
  // Groq post-process adjustment applied on top of XGBoost crowd score
  groqAdjustment  Float?    // points to add to mlCrowdScore (bounded ±35)
  groqReasoning   String?   // one-sentence explanation from Groq
  groqAdjustedAt  DateTime? // when groqAdjustment was last computed; re-sync after 7 days

  predictions     Prediction[]

  @@unique([parkId, date])
  @@index([date])
}

// Accuracy join table: maps a historical prediction to actual wait for a given date.
model Prediction {
  id              String      @id @default(uuid())
  rideId          Int
  rideName        String
  predictedFor    DateTime
  predictedWait   Int
  actualWait      Int?        // filled in after the day passes
  dateContextId   String?
  dateContext     DateContext? @relation(fields: [dateContextId], references: [id])
  createdAt       DateTime    @default(now())

  @@index([rideId, predictedFor])
  @@index([dateContextId])
}

// Which ml-service job wrote a CollectRun row. Keep in sync with
// ml-service/common.py (JOBS); tests/test_common.py checks that.
enum JobKind {
  collect
  train
  archive
}

// One row per ml-service job run. Filter on `job`: collect, train and archive
// all log here.
model CollectRun {
  id           String   @id @default(uuid())
  job          JobKind  @default(collect)
  ranAt        DateTime @default(now())
  rowsUpserted Int
  success      Boolean
  errorMessage String?

  @@index([job, ranAt(sort: Desc)])
}

// Hourly aggregates of WaitTimeRecord after the 30-day raw retention window.
// Each row = one Pacific hour of data for one ride on one park date.
// Training reads these alongside every unarchived WaitTimeRecord row.
model HourlyWaitSummary {
  id          String   @id @default(uuid())
  rideId      Int
  rideName    String
  landName    String
  parkId      Int      @default(16)
  date        DateTime // midnight UTC of the park date
  hour        Int      // 0–23
  avgWait     Float
  peakWait    Int
  sampleCount Int
  observedSampleCount Int @default(0)
  openSampleCount Int @default(0)
  isOpen      Boolean

  @@unique([rideId, date, hour])
  @@index([rideId, date])
  @@index([date])
  @@index([parkId, date])
}

// Current metadata for one Queue-Times attraction. This prevents new serving
// tables from repeating mutable display strings in every fact row.
model RideCatalog {
  parkId    Int
  rideId    Int
  rideName  String
  landName  String
  isActive  Boolean  @default(true)
  updatedAt DateTime @default(now())

  @@id([parkId, rideId])
}

// One reproducible train/scoring run. `metrics` holds compact aggregate
// validation results, never per-slot observations or model binaries.
model ModelRun {
  id             String   @id @default(uuid())
  version        String
  featureVersion String
  trainedAt      DateTime @default(now())
  trainingCutoff DateTime
  metrics        Json?
  parkDayForecasts ParkDayForecast[]
  rideDayForecasts RideDayForecast[]
  evaluations      ForecastEvaluation[]
}

// Fast calendar-serving projection, one row per park-local day.
model ParkDayForecast {
  id         String    @id @default(uuid())
  parkId     Int
  date       DateTime
  crowdScore Int
  modelRunId String?
  modelRun   ModelRun? @relation(fields: [modelRunId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@unique([parkId, date])
  @@index([date])
}

// Fast per-ride day-serving projection; slot records remain available only
// for a selected ride's chart.
model RideDayForecast {
  id           String    @id @default(uuid())
  parkId       Int
  rideId       Int
  date         DateTime
  avgWait      Int
  peakWait     Int
  mlConfidence Float
  modelRunId   String?
  modelRun     ModelRun? @relation(fields: [modelRunId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@unique([parkId, rideId, date])
  @@index([parkId, date])
}

// A daily issued prediction is retained long enough to compare model versions
// and forecast horizons without keeping every historical slot prediction.
model ForecastEvaluation {
  id               String   @id @default(uuid())
  modelRunId       String
  modelRun         ModelRun @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  parkId           Int
  rideId           Int
  targetDate       DateTime
  horizonBucket    String
  predictedAvgWait Int
  actualAvgWait    Int?
  mae              Float?
  createdAt        DateTime @default(now())

  @@unique([modelRunId, parkId, rideId, targetDate])
  @@index([targetDate])
}
